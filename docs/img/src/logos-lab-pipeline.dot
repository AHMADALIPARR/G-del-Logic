digraph G {
  rankdir=TB; nodesep=0.4; ranksep=0.55; newrank=true;
  graph [fontname="DejaVu Sans", bgcolor="white", pad=0.35, dpi=200]
  node [fontname="DejaVu Sans", fontsize=13, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#3b5b8c", penwidth=1.4, margin="0.2,0.12"]
  edge [fontname="DejaVu Sans", fontsize=11, color="#3b5b8c", penwidth=1.4, arrowsize=0.9]
  subgraph cluster_a { label=<<b>Build the pieces</b>>; labeljust=l; fontname="DejaVu Sans"; fontsize=13; color="#b8c4d6"; style="rounded"; 
    syn [label=<<b>Syntax</b><br/>terms, atoms,<br/>clauses, goals>];
    uni [label=<<b>Unify</b><br/>match two atoms,<br/>build a substitution>];
    sta [label=<<b>State</b><br/>goals, bindings, saved<br/>alternatives, cut, Δ>];
    {rank=same; syn; uni; sta}
    syn -> uni -> sta;
  }
  subgraph cluster_b { label=<<b>Search</b>>; labeljust=l; fontname="DejaVu Sans"; fontsize=13; color="#b8c4d6"; style="rounded"; 
    res [label=<<b>Resolve step</b><br/>one move at a time,<br/>every successor listed>];
    gua [label=<<b>Guards</b><br/>weight check<br/>before each move>, fillcolor="#fff6e0", color="#b07a10"];
    sol [label=<<b>Solve</b><br/>runs on fuel,<br/>so it always stops>, fillcolor="#e6f4ea", color="#2e7d4f"];
    {rank=same; res; gua; sol}
    res -> gua -> sol;
  }
  subgraph cluster_c { label=<<b>Check</b>>; labeljust=l; fontname="DejaVu Sans"; fontsize=13; color="#b8c4d6"; style="rounded"; 
    trc [label=<<b>Trace</b><br/>list of steps<br/>from any engine>, fillcolor="#f2f2f2", color="#777777"];
    chk [label=<<b>Checker</b><br/>replays the trace<br/>step by step>, fillcolor="#e6f4ea", color="#2e7d4f"];
    drv [label=<<b>Derivation</b><br/>a proof tree<br/>that the answer holds>, fillcolor="#d4edda", color="#2e7d4f", penwidth=2.2];
    {rank=same; trc; chk; drv}
    trc -> chk -> drv;
  }
  sta -> res [constraint=true];
  sol -> drv [label=<  <i>replay_sound</i>: every answer has a derivation>, fontsize=11];
}
